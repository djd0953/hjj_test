{
  "name": "hsad-sso-mock-idp",
  "version": "0.1.0",
  "private": true,
  "description": "Local SAML 2.0 mock IdP that mimics sso.hsad.co.kr for dev/e2e testing",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen-cert": "bash scripts/gen-cert.sh"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "samlify": "^2.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}

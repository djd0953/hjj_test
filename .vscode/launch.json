{
  "version": "0.2.0",
  "configurations": [
    /**
     * 1) Backend: NestJS dev script (nest start --watch)
     * - backend 의 npm run dev 를 터미널에서 실행
     * - --debug 9229 로 inspector 열고 VSCode Auto Attach 가 자동으로 붙음
     */
    {
      "name": "Backend: Debug (nest)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --debug 9229",
      "cwd": "${workspaceFolder}/backend"
    },

    /**
     * 2) Frontend: Next.js dev 서버 실행(터미널)
     * - BE 디버깅과 함께 실행만 되는 용도
     */
    {
      "name": "Frontend: Run (next dev)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "npm run dev"
    },

    /**
     * (선택) Docker attach는 기존 그대로 유지 가능
     */
    {
      "type": "pwa-node",
      "request": "attach",
      "name": "Attach to Docker Node",
      "address": "localhost",
      "port": 9229,
      "restart": true,
      "protocol": "inspector",
      "skipFiles": ["<node_internals>/**"],
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/usr/src/app"
    }
  ],

  "compounds": [
    /**
     * 3) 풀스택 한번에
     * - BE는 디버그(attach), FE는 dev 서버 실행만
     */
    {
      "name": "Fullstack: Backend + Frontend",
      "configurations": [
        "Backend: Debug (nest)",
        "Frontend: Run (next dev)"
      ],
      "stopAll": true
    }
  ]
}

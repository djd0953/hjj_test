{
  "version": "0.2.0",
  "configurations": [
    /**
     * 1) Backend: Express + TS (nodemon + ts-node)
     * - backend 폴더 기준으로 실행되도록 cwd 설정
     * - src/app.ts 경로도 backend 기준으로 맞춤
     */
    {
      "name": "Backend: Debug (nodemon)",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "${workspaceFolder}/backend/node_modules/.bin/nodemon",
      "runtimeArgs": [
        "--watch",
        "src",
        "--ext",
        "ts,js,json",
        "--exec",
        "node",
        "--inspect=9229",
        "-r",
        "ts-node/register",
        "-r",
        "tsconfig-paths/register",
        "src/app.ts"
      ],
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "NODE_ENV": "development"
      },
      "skipFiles": ["<node_internals>/**"]
    },

    /**
     * 2) Frontend: Next.js dev 서버 실행(터미널)
     * - NODE_OPTIONS로 inspect 포트(9230) 열기
     * - Windows가 아니라 macOS 기준이지만, cross-env 쓰면 더 안전
     */
    {
      "name": "Frontend: Run (next dev)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "NODE_OPTIONS=--inspect=9230 npm run dev"
    },

    /**
     * 3) Frontend: Next.js에 attach
     * - 위 Run이 켜진 상태에서 attach로 디버깅
     */
    {
      "name": "Frontend: Attach (9230)",
      "type": "pwa-node",
      "request": "attach",
      "port": 9230,
      "restart": true,
      "cwd": "${workspaceFolder}/frontend",
      "skipFiles": ["<node_internals>/**"]
    },

    /**
     * (선택) Docker attach는 기존 그대로 유지 가능
     */
    {
      "type": "pwa-node",
      "request": "attach",
      "name": "Attach to Docker Node",
      "address": "localhost",
      "port": 9229,
      "restart": true,
      "protocol": "inspector",
      "skipFiles": ["<node_internals>/**"],
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/usr/src/app"
    }
  ],

  "compounds": [
    /**
     * 4) 풀스택 한번에
     * - Frontend는 "Run" + "Attach" 둘 다 포함해야 실제 브레이크포인트가 잘 걸립니다.
     */
    {
      "name": "Fullstack: Backend + Frontend",
      "configurations": [
        "Backend: Debug (nodemon)",
        "Frontend: Run (next dev)",
        "Frontend: Attach (9230)"
      ],
      "stopAll": true
    }
  ]
}
